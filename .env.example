# Replace the placeholders below with credentials from your Supabase project:
#   Dashboard > Project Settings > API
#
# VITE_SUPABASE_URL       -> "Project URL"
# VITE_SUPABASE_ANON_KEY  -> "Publishable key" (or "anon public" key on older projects)

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY
