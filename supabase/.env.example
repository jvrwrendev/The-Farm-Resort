# Supabase Edge Function secrets for send-booking-confirmation
# Set these with: npx supabase secrets set KEY=value
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
MAIL_FROM=The Farm Resort <no-reply@yourdomain.com>
APP_URL=https://your-site-url